# Build artifacts (only inside tests/ — the toolchain has .o/.a files we MUST keep)
tests/**/*.riscv
tests/**/*.dump
tests/**/*.slm
tests/**/*.o
tests/**/exp.dump
tests/**/output.csv

# But keep .a files in the toolchain's own staging area if any test linked one in
# (none currently, but rule above is scoped so we don't need a negation)

# PMU firmware build
tests/*/pmu_firmware/build/
tests/*/text_section.bin
tests/*/data_rodata_bss.bin

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Don't track Python bytecode generated under vendored deps
# (the stdlib under toolchain/python-runtime/ already ships its own .pyc).
scripts/vendor/**/__pycache__/
scripts/vendor/**/*.pyc

# FreeRTOS build artifacts
freeRTOS/freertos_hello/build/

# Linux build artifacts (regenerated by linux/scripts/build.sh)
linux/build.log
linux/cva6-sdk/buildroot/output/
linux/cva6-sdk/buildroot/dl/
linux/cva6-sdk/install64/
linux/cva6-sdk/opensbi/build/
